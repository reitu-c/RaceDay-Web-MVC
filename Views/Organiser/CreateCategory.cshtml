@model RaceDay.Web.Models.CategoryFormViewModel

@{
    ViewData["Title"] = "Create Category";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card">
                <div class="card-header">
                    <h3 class="text-white mb-0">Create Category</h3>
                </div>

                <div class="card-body p-4">

                    <p class="text-muted">
                        Add a category for:
                        <strong>@ViewBag.EventName</strong>
                    </p>

                    <form asp-action="CreateCategory" method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="EventID" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="CategoryName"
                                   class="form-label">
                                Category Name
                            </label>

                            <input asp-for="CategoryName"
                                   class="form-control"
                                   placeholder="e.g. 5 KM Fun Run" />

                            <span asp-validation-for="CategoryName"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DistanceKM"
                                   class="form-label">
                                Distance (KM)
                            </label>

                            <input asp-for="DistanceKM"
                                   type="number"
                                   step="0.01"
                                   min="0.01"
                                   class="form-control" />

                            <span asp-validation-for="DistanceKM"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EntryFee"
                                   class="form-label">
                                Entry Fee (R)
                            </label>

                            <input asp-for="EntryFee"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control" />

                            <span asp-validation-for="EntryFee"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="MaxParticipants"
                                   class="form-label">
                                Maximum Participants
                            </label>

                            <input asp-for="MaxParticipants"
                                   type="number"
                                   min="1"
                                   class="form-control"
                                   placeholder="Leave blank for unlimited" />

                            <span asp-validation-for="MaxParticipants"
                                  class="text-danger">
                            </span>

                            <small class="text-muted">
                                This field is optional.
                            </small>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-primary">
                                Create Category
                            </button>

                            <a asp-action="Categories"
                               asp-route-eventId="@Model.EventID"
                               class="btn btn-secondary">
                                Cancel
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
