@{
    ViewData["Title"] = "Home";
}

<div class="p-5 mb-4 rounded-3 text-white"
     style="background: linear-gradient(135deg, #173B57, #2878A5);">

    <div class="container-fluid py-4">
        <h1 class="display-4 fw-bold text-white">
            Welcome to RaceDay
        </h1>

        <p class="col-md-8 fs-5 text-white">
            Your journey. Your finish line.
            Discover exciting sporting events, register for races,
            track your participation and celebrate your achievements.
        </p>

        <a asp-controller="Auth" asp-action="Register"
           class="btn btn-warning btn-lg me-2">
            Get Started
        </a>

        <a asp-controller="Auth" asp-action="Login"
           class="btn btn-outline-light btn-lg">
            Login
        </a>
    </div>
</div>

<div class="text-center mb-4">
    <h2>Everything You Need for RaceDay</h2>
    <p class="text-muted">
        One platform to manage and participate in sporting events.
    </p>
</div>

<div class="row g-4 mb-5">

    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center p-4">
                <h4>Discover Events</h4>
                <p>
                    Explore upcoming sporting events and find
                    opportunities to participate.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center p-4">
                <h4>Manage Participation</h4>
                <p>
                    Register for events and keep track of your
                    sporting activities.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center p-4">
                <h4>Track Results</h4>
                <p>
                    View race results, finishing positions
                    and your achievements.
                </p>
            </div>
        </div>
    </div>

</div>

