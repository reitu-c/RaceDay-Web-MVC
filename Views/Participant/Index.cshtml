@{
    ViewData["Title"] = "Participant Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">

    <!-- Welcome Section -->
    <div class="p-4 p-md-5 mb-4 rounded-4 text-white"
         style="background: linear-gradient(120deg, #172554, #4F46E5);">

        <h1 class="fw-bold">
            Welcome, @ViewBag.FullName!
        </h1>

        <p class="lead mb-3">
            Your next racing adventure starts here.
        </p>

        <a asp-controller="Participant"
           asp-action="Events"
           class="btn btn-light btn-lg fw-bold">
            Explore Events
        </a>
    </div>

    <!-- Quick Navigation -->
    <h3 class="fw-bold mb-3">My RaceDay</h3>

    <div class="row g-4 mb-5">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold">My Events</h5>
                    <p class="text-muted">
                        View all the events you have enrolled in.
                    </p>

                    <a asp-controller="Participant"
                       asp-action="MyEvents"
                       class="btn btn-outline-primary">
                        View My Events
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold">My Results</h5>
                    <p class="text-muted">
                        Track your finishing times and race positions.
                    </p>

                    <a asp-controller="Participant"
                       asp-action="MyResults"
                       class="btn btn-outline-primary">
                        View My Results
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold">My Profile</h5>
                    <p class="text-muted">
                        View and update your personal information.
                    </p>

                    <a asp-controller="Profile"
                       asp-action="Index"
                       class="btn btn-outline-primary">
                        View Profile
                    </a>
                </div>
            </div>
        </div>

    </div>

    <!-- Upcoming Events -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold">Upcoming Events</h3>

        <a asp-controller="Participant"
           asp-action="Events"
           class="text-decoration-none fw-semibold">
            View All
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body text-center py-5">

            <h5 class="text-muted">
                Discover your next race!
            </h5>

            <p class="text-muted">
                Explore available events and find your next challenge.
            </p>

            <a asp-controller="Participant"
               asp-action="Events"
               class="btn btn-primary">
                Browse Events
            </a>

        </div>
    </div>

</div>

