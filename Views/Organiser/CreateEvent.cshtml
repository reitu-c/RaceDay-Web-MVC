@model RaceDay.Web.Models.EventFormViewModel

@{
    ViewData["Title"] = "Create Event";
}

<div class="container py-4">

    <div class="card mx-auto" style="max-width: 750px;">

        <div class="card-header">
            Create a New Race Event
        </div>

        <div class="card-body p-4">

            <p class="text-muted">
                Enter the details below to create a new RaceDay event.
            </p>

            <form asp-controller="Organiser"
                  asp-action="CreateEvent"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="EventName"
                           class="form-label"></label>

                    <input asp-for="EventName"
                           class="form-control"
                           placeholder="Enter event name" />

                    <span asp-validation-for="EventName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EventDate"
                           class="form-label"></label>

                    <input asp-for="EventDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="EventDate"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Location"
                           class="form-label"></label>

                    <input asp-for="Location"
                           class="form-control"
                           placeholder="Enter event location" />

                    <span asp-validation-for="Location"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description"
                           class="form-label"></label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Describe the event"></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Status"
                           class="form-label"></label>

                    <select asp-for="Status"
                            class="form-select">
                        <option value="Open">Open</option>
                        <option value="Closed">Closed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>

                    <span asp-validation-for="Status"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Create Event
                    </button>

                    <a asp-controller="Organiser"
                       asp-action="Events"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>
</div>
