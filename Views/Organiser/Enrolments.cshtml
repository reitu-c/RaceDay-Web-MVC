@model List<RaceDay.Web.Models.OrganiserEnrolmentViewModel>

@{
    ViewData["Title"] = "Manage Enrolments";
}

<div class="container py-4">

    <h1>Manage Enrolments</h1>

    <p class="text-muted mb-4">
        View participants registered for your race events.
    </p>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="card p-4 text-center">
            <h5>No enrolments found</h5>
            <p class="text-muted mb-0">
                Participants' enrolments will appear here.
            </p>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Participant</th>
                            <th>Email</th>
                            <th>Event</th>
                            <th>Category</th>
                            <th>Distance</th>
                            <th>Entry Fee</th>
                            <th>Enrolment Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@item.ParticipantName</strong>
                                    <br />
                                    <small class="text-muted">
                                        ID: @item.ParticipantID
                                    </small>
                                </td>

                                <td>@item.ParticipantEmail</td>

                                <td>@item.EventName</td>

                                <td>@item.CategoryName</td>

                                <td>@item.DistanceKM KM</td>

                                <td>R @item.EntryFee.ToString("N2")</td>

                                <td>
                                    @item.EnrolmentDate.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @if (item.Status == "Confirmed")
                                    {
                                        <span class="badge bg-success">
                                            Confirmed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @item.Status
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        </div>
    }

</div>
