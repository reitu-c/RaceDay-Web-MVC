@model List<RaceDay.Web.Models.EventViewModel>

@{
    ViewData["Title"] = "Manage Events";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Manage Events</h1>
            <p class="text-muted">
                Create, view and manage your race events.
            </p>
        </div>

        <a asp-controller="Organiser"
           asp-action="CreateEvent"
           class="btn btn-primary">
            + Create Event
        </a>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="card p-4 text-center">
            <h5>No events found</h5>
            <p class="text-muted mb-0">
                You have not created any events yet.
            </p>
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100">

                        <div class="card-header">
                            @item.EventName
                        </div>

                        <div class="card-body">

                            <p>
                                <strong>Date:</strong>
                                @item.EventDate.ToString("dd MMMM yyyy")
                            </p>

                            <p>
                                <strong>Location:</strong>
                                @item.Location
                            </p>

                            <p>
                                <strong>Description:</strong>
                                @(string.IsNullOrWhiteSpace(item.Description)
                                                        ? "No description provided."
                                                        : item.Description)
                    </p>

                            <p>
                                <strong>Status:</strong>

                        @if (item.Status == "Open")
                                {
                                    <span class="badge bg-success">Open</span>
                                }
                                else if (item.Status == "Closed")
                                {
                                    <span class="badge bg-secondary">Closed</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Cancelled</span>
                                }
                            </p>

                            <div class="d-flex gap-2 mt-3">

                                <a asp-controller="Organiser"
                                   asp-action="EditEvent"
                                   asp-route-id="@item.EventID"
                                   class="btn btn-warning btn-sm">
                                    Edit
                                </a>

                                <a asp-controller="Organiser"
                                   asp-action="Categories"
                                   asp-route-eventId="@item.EventID"
                                   class="btn btn-sm btn-info">
                                    Categories
                                </a>

                                <form asp-controller="Organiser"
                                      asp-action="DeleteEvent"
                                      asp-route-id="@item.EventID"
                                      method="post"
                                      onsubmit="return confirm('Are you sure you want to delete this event?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-danger btn-sm">
                                        Delete
                                    </button>

                                </form>

                            </div>

                        </div>
                    </div>
                </div>
            }

        </div>
    }

</div>
