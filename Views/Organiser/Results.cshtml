@model RaceDay.Web.Models.OrganiserResultsPageViewModel

@{
    ViewData["Title"] = "Manage Results";
}

<div class="container py-4">

    <div class="mb-4">
        <h1>Manage Race Results</h1>
        <p class="text-muted">
            View recorded results and manage participant race performance.
        </p>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>Recorded Results</h4>

        <a asp-action="CreateResult" class="btn btn-primary">
            + Record Result
        </a>
    </div>

    @if (Model.Results == null || !Model.Results.Any())
    {
        <div class="card p-4 text-center mb-4">
            <h5>No results recorded yet</h5>
            <p class="text-muted mb-0">
                Recorded race results will appear here.
            </p>
        </div>
    }
    else
    {
        <div class="card mb-4">
            <div class="card-body table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Participant</th>
                            <th>Event</th>
                            <th>Category</th>
                            <th>Finish Time</th>
                            <th>Overall Position</th>
                            <th>Category Position</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.Results)
                        {
                            <tr>
                                <td>@item.ParticipantName</td>
                                <td>@item.EventName</td>
                                <td>@item.CategoryName</td>

                                <td>
                                    @(item.FinishTime?.ToString(@"hh\:mm\:ss") ?? "N/A")
                                </td>

                                <td>
                                    @(item.OverallPosition?.ToString() ?? "N/A")
                                </td>

                                <td>
                                    @(item.CategoryPosition?.ToString() ?? "N/A")
                                </td>

                                <td>
                                    @if (item.ResultStatus == "Finished")
                                    {
                                        <span class="badge bg-success">
                                            Finished
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @item.ResultStatus
                                        </span>
                                    }
                                </td>

                                <td>
                                    <a asp-action="EditResult"
                                       asp-route-id="@item.ResultID"
                                       class="btn btn-warning btn-sm">
                                        Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        </div>
    }

</div>
